{
  "name": "opencart-web-api-pw",
  "description": "Automation framework to automate the Opencart web application, and GoRest and Paypal APIs",
  "author": "Anil Kumar Cheepuru",
  "version": "1.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "src/pages/",
    "src/fixtures/",
    "src/api/",
    "src/utils/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chrome": "npx playwright test --project=chromium",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:clean": "rm -rf allure-results allure-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "pom",
    "automation",
    "testing",
    "sdet",
    "api-testing",
    "data-driven",
    "framework"
  ],
  "license": "ISC",
  "homepage": "https://github.com/anilcheepuru92/OpenCart-Web-API-PW",
  "repository": {
    "type": "git",
    "url": "https://github.com/anilcheepuru92/OpenCart-Web-API-PW.git"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  }
}
